+++ b/node_modules/react-native-floating-bubble/android/src/main/java/com/reactlibrary/WoodCounterView.java
@@ -0,0 +1,315 @@
+package com.reactlibrary;
+
+import android.content.Context;
+import android.graphics.BlurMaskFilter;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.util.AttributeSet;
+import android.view.View;
+
+/**
+ * A realistic wooden finger tally counter, drawn entirely in code so it stays sharp at any
+ * bubble scale: grained wood body, recessed LCD with 7-segment digits, a domed chrome count
+ * button that sinks when pressed, and a small chrome reset button.
+ *
+ * The configured colour stains the wood; the default gold keeps it natural.
+ */
+public class WoodCounterView extends View {
+    public static final int PART_NONE = 0;
+    public static final int PART_COUNT = 1;
+    public static final int PART_RESET = 2;
+
+    private static final int NATURAL_WOOD = 0xFFC27C3A;
+    // segments a,b,c,d,e,f,g for 0-9
+    private static final int[] DIGITS = { 0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F };
+
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path body = new Path();
+    private final RectF tmp = new RectF();
+    private final RectF lcdBezel = new RectF();
+    private final RectF lcd = new RectF();
+    private float countCx, countCy, countR, resetCx, resetCy, resetR;
+
+    private int count = 0;
+    private int wood = NATURAL_WOOD;
+    private boolean showBorder = true;
+    private boolean showReset = true;
+    private int pressed = PART_NONE;
+
+    public WoodCounterView(Context c) { this(c, null); }
+
+    public WoodCounterView(Context c, AttributeSet a) {
+        super(c, a);
+        setLayerType(LAYER_TYPE_SOFTWARE, null); // BlurMaskFilter needs a software layer
+    }
+
+    // ── public API ───────────────────────────────────────────────
+    public void setCount(int value) { if (value != count) { count = value; invalidate(); } }
+
+    public void setConfig(String colorHex, boolean border, boolean reset) {
+        wood = woodFor(colorHex);
+        showBorder = border;
+        showReset = reset;
+        invalidate();
+    }
+
+    public void setPressedPart(int part) { if (part != pressed) { pressed = part; invalidate(); } }
+
+    /** Which control is under (x, y) in view coordinates. Anywhere on the body counts. */
+    public int partAt(float x, float y) {
+        if (showReset && dist(x, y, resetCx, resetCy) <= resetR * 1.8f) return PART_RESET;
+        return PART_COUNT;
+    }
+
+    // ── colour ───────────────────────────────────────────────────
+    private static int woodFor(String hex) {
+        int c;
+        try { c = Color.parseColor(hex); } catch (Exception e) { return NATURAL_WOOD; }
+        if (c == 0xFFB8860B || c == 0xFFD4AF37) return NATURAL_WOOD;
+        float t = c == Color.BLACK ? 0.7f : 0.5f;
+        return mix(NATURAL_WOOD, c, t);
+    }
+
+    private static int mix(int a, int b, float t) {
+        return Color.rgb(
+                (int) (Color.red(a) + (Color.red(b) - Color.red(a)) * t),
+                (int) (Color.green(a) + (Color.green(b) - Color.green(a)) * t),
+                (int) (Color.blue(a) + (Color.blue(b) - Color.blue(a)) * t));
+    }
+
+    private static int shade(int c, float f) { // f<1 darker, f>1 lighter
+        if (f < 1) return mix(Color.BLACK, c, f);
+        return mix(c, Color.WHITE, f - 1);
+    }
+
+    private static int alpha(int c, int a) { return (c & 0x00FFFFFF) | (a << 24); }
+
+    /** A shader is multiplied by the paint's alpha, so reset it to opaque first. */
+    private void shader(Shader sh) {
+        paint.setColor(Color.BLACK);
+        paint.setShader(sh);
+    }
+
+    private static float dist(float x1, float y1, float x2, float y2) { return (float) Math.hypot(x1 - x2, y1 - y2); }
+
+    // ── layout ───────────────────────────────────────────────────
+    @Override
+    protected void onSizeChanged(int w, int h, int ow, int oh) {
+        super.onSizeChanged(w, h, ow, oh);
+        float pad = w * 0.06f;
+        RectF r = new RectF(pad, pad * 0.6f, w - pad, h - pad * 1.2f);
+        float top = r.width() * 0.34f, bottom = r.width() * 0.46f;
+        body.reset();
+        body.addRoundRect(r, new float[] { top, top, top, top, bottom, bottom, bottom, bottom }, Path.Direction.CW);
+
+        float bw = r.width();
+        lcdBezel.set(r.left + bw * 0.1f, r.top + r.height() * 0.1f, r.right - bw * 0.1f, r.top + r.height() * 0.38f);
+        float inset = bw * 0.045f;
+        lcd.set(lcdBezel.left + inset, lcdBezel.top + inset * 1.1f, lcdBezel.right - inset, lcdBezel.bottom - inset * 1.1f);
+
+        countR = bw * 0.27f;
+        countCx = r.centerX();
+        countCy = r.bottom - countR - r.height() * 0.08f;
+        resetR = bw * 0.065f;
+        resetCx = r.right - bw * 0.2f;
+        resetCy = (lcdBezel.bottom + (countCy - countR)) / 2f;
+    }
+
+    // ── drawing ──────────────────────────────────────────────────
+    @Override
+    protected void onDraw(Canvas canvas) {
+        int w = getWidth(), h = getHeight();
+        if (w == 0 || h == 0) return;
+        paint.reset();
+        paint.setAntiAlias(true);
+
+        // drop shadow
+        paint.setColor(0x66000000);
+        paint.setMaskFilter(new BlurMaskFilter(w * 0.05f, BlurMaskFilter.Blur.NORMAL));
+        canvas.save();
+        canvas.translate(0, w * 0.025f);
+        canvas.drawPath(body, paint);
+        canvas.restore();
+        paint.setMaskFilter(null);
+
+        drawWood(canvas, w, h);
+        drawLcd(canvas);
+        if (showReset) drawChrome(canvas, resetCx, resetCy, resetR, pressed == PART_RESET, false);
+        drawChrome(canvas, countCx, countCy, countR, pressed == PART_COUNT, true);
+    }
+
+    private void drawWood(Canvas canvas, int w, int h) {
+        RectF b = new RectF();
+        body.computeBounds(b, true);
+
+        // base tone, lit from the top-left
+        shader(new LinearGradient(b.left, b.top, b.right, b.bottom,
+                new int[] { shade(wood, 1.12f), wood, shade(wood, 0.72f) }, new float[] { 0f, 0.55f, 1f }, Shader.TileMode.CLAMP));
+        canvas.drawPath(body, paint);
+        paint.setShader(null);
+
+        // grain: gently waving vertical fibres, deterministic so the bubble never "shimmers"
+        canvas.save();
+        canvas.clipPath(body);
+        paint.setStyle(Paint.Style.STROKE);
+        Path grain = new Path();
+        int lines = 22;
+        for (int i = 0; i < lines; i++) {
+            float x0 = b.left + b.width() * (i + 0.5f) / lines;
+            float amp = b.width() * (0.012f + 0.01f * ((i * 7) % 5) / 4f);
+            float phase = i * 1.7f;
+            grain.reset();
+            for (int s = 0; s <= 24; s++) {
+                float y = b.top + b.height() * s / 24f;
+                float x = x0 + (float) Math.sin(phase + s * 0.55f) * amp + (float) Math.sin(s * 0.18f + i) * amp * 0.6f;
+                if (s == 0) grain.moveTo(x, y); else grain.lineTo(x, y);
+            }
+            paint.setStrokeWidth(b.width() * (i % 3 == 0 ? 0.012f : 0.006f));
+            paint.setColor(alpha(shade(wood, 0.55f), i % 3 == 0 ? 70 : 40));
+            canvas.drawPath(grain, paint);
+        }
+        // a couple of soft knots of darker grain
+        paint.setStyle(Paint.Style.STROKE);
+        for (int k = 0; k < 3; k++) {
+            paint.setStrokeWidth(b.width() * 0.006f);
+            paint.setColor(alpha(shade(wood, 0.5f), 45));
+            float kx = b.left + b.width() * 0.22f, ky = b.top + b.height() * 0.62f;
+            tmp.set(kx - b.width() * (0.05f + k * 0.03f), ky - b.width() * (0.02f + k * 0.015f),
+                    kx + b.width() * (0.05f + k * 0.03f), ky + b.width() * (0.02f + k * 0.015f));
+            canvas.drawOval(tmp, paint);
+        }
+        paint.setStyle(Paint.Style.FILL);
+
+        // varnish sheen
+        shader(new RadialGradient(b.left + b.width() * 0.3f, b.top + b.height() * 0.18f, b.width() * 0.8f,
+                new int[] { 0x40FFFFFF, 0x00FFFFFF }, null, Shader.TileMode.CLAMP));
+        canvas.drawRect(b, paint);
+        // edge darkening
+        shader(new RadialGradient(b.centerX(), b.centerY(), Math.max(b.width(), b.height()) * 0.62f,
+                new int[] { 0x00000000, 0x00000000, 0x55000000 }, new float[] { 0f, 0.7f, 1f }, Shader.TileMode.CLAMP));
+        canvas.drawRect(b, paint);
+        paint.setShader(null);
+        canvas.restore();
+
+        if (showBorder) {
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(w * 0.018f);
+            paint.setColor(shade(wood, 0.45f));
+            canvas.drawPath(body, paint);
+            paint.setStrokeWidth(w * 0.008f);
+            paint.setColor(alpha(shade(wood, 1.3f), 120));
+            canvas.save();
+            canvas.translate(0, w * 0.006f);
+            canvas.restore();
+            paint.setStyle(Paint.Style.FILL);
+        }
+    }
+
+    private void drawLcd(Canvas canvas) {
+        float r = lcdBezel.height() * 0.28f;
+        // glossy black bezel
+        shader(new LinearGradient(0, lcdBezel.top, 0, lcdBezel.bottom,
+                new int[] { 0xFF3A3A3A, 0xFF0D0D0D, 0xFF000000 }, new float[] { 0f, 0.5f, 1f }, Shader.TileMode.CLAMP));
+        canvas.drawRoundRect(lcdBezel, r, r, paint);
+        // LCD glass
+        float lr = r * 0.6f;
+        shader(new LinearGradient(0, lcd.top, 0, lcd.bottom,
+                new int[] { 0xFFC9D3BD, 0xFFB2BDA4, 0xFFA3AE95 }, new float[] { 0f, 0.6f, 1f }, Shader.TileMode.CLAMP));
+        canvas.drawRoundRect(lcd, lr, lr, paint);
+        paint.setShader(null);
+        // inner shadow along the top edge of the glass
+        shader(new LinearGradient(0, lcd.top, 0, lcd.top + lcd.height() * 0.25f,
+                new int[] { 0x55000000, 0x00000000 }, null, Shader.TileMode.CLAMP));
+        canvas.drawRoundRect(lcd, lr, lr, paint);
+        paint.setShader(null);
+
+        drawDigits(canvas);
+
+        // glass reflection on the top half
+        canvas.save();
+        tmp.set(lcd.left, lcd.top, lcd.right, lcd.top + lcd.height() * 0.45f);
+        shader(new LinearGradient(0, tmp.top, 0, tmp.bottom, new int[] { 0x40FFFFFF, 0x08FFFFFF }, null, Shader.TileMode.CLAMP));
+        canvas.drawRoundRect(tmp, lr, lr, paint);
+        paint.setShader(null);
+        canvas.restore();
+    }
+
+    private void drawDigits(Canvas canvas) {
+        String s = String.valueOf(Math.max(0, count));
+        int cells = Math.max(4, s.length());
+        float padX = lcd.width() * 0.07f, padY = lcd.height() * 0.17f;
+        float areaW = lcd.width() - padX * 2, areaH = lcd.height() - padY * 2;
+        float gap = areaW * 0.05f;
+        float cw = Math.min((areaW - gap * (cells - 1)) / cells, areaH * 0.58f);
+        float startX = lcd.right - padX - (cw * cells + gap * (cells - 1));
+        float t = cw * 0.2f;
+
+        canvas.save();
+        canvas.skew(-0.08f, 0);
+        canvas.translate(lcd.centerY() * 0.08f, 0);
+        for (int i = 0; i < cells; i++) {
+            int fromRight = cells - 1 - i;
+            int idx = s.length() - 1 - fromRight;
+            int mask = idx >= 0 ? DIGITS[s.charAt(idx) - '0'] : 0;
+            float x = startX + i * (cw + gap);
+            drawDigit(canvas, x, lcd.top + padY, cw, areaH, t, 0x7F, 0x14000000); // ghost "8"
+            if (mask != 0) drawDigit(canvas, x, lcd.top + padY, cw, areaH, t, mask, 0xF0182014);
+        }
+        canvas.restore();
+    }
+
+    private void drawDigit(Canvas canvas, float x, float y, float w, float h, float t, int mask, int color) {
+        paint.setColor(color);
+        float g = t * 0.22f, rr = t * 0.45f, mid = y + h / 2f;
+        RectF[] seg = {
+                new RectF(x + t * 0.5f + g, y, x + w - t * 0.5f - g, y + t),                 // a
+                new RectF(x + w - t, y + t * 0.5f + g, x + w, mid - g),                       // b
+                new RectF(x + w - t, mid + g, x + w, y + h - t * 0.5f - g),                   // c
+                new RectF(x + t * 0.5f + g, y + h - t, x + w - t * 0.5f - g, y + h),          // d
+                new RectF(x, mid + g, x + t, y + h - t * 0.5f - g),                           // e
+                new RectF(x, y + t * 0.5f + g, x + t, mid - g),                               // f
+                new RectF(x + t * 0.5f + g, mid - t / 2f, x + w - t * 0.5f - g, mid + t / 2f), // g
+        };
+        for (int i = 0; i < 7; i++) if ((mask & (1 << i)) != 0) canvas.drawRoundRect(seg[i], rr, rr, paint);
+    }
+
+    private void drawChrome(Canvas canvas, float cx, float cy, float r, boolean down, boolean big) {
+        // recess in the wood
+        paint.setColor(0x80000000);
+        paint.setMaskFilter(new BlurMaskFilter(r * 0.15f, BlurMaskFilter.Blur.NORMAL));
+        canvas.drawCircle(cx, cy + r * 0.06f, r * 1.04f, paint);
+        paint.setMaskFilter(null);
+
+        // chrome bezel ring
+        shader(new LinearGradient(cx - r, cy - r, cx + r, cy + r,
+                new int[] { 0xFFFFFFFF, 0xFF9AA0A6, 0xFFE8EBEE, 0xFF5E6369 }, new float[] { 0f, 0.4f, 0.65f, 1f }, Shader.TileMode.CLAMP));
+        canvas.drawCircle(cx, cy, r, paint);
+        paint.setShader(null);
+
+        // dark gap between ring and cap
+        float capR = r * (big ? 0.8f : 0.72f);
+        paint.setColor(0xFF2B2E31);
+        canvas.drawCircle(cx, cy, capR * 1.04f, paint);
+
+        // domed cap; sinks and darkens when pressed
+        float dy = down ? r * 0.04f : 0f;
+        float cr = down ? capR * 0.96f : capR;
+        shader(new RadialGradient(cx - cr * 0.3f, cy - cr * 0.35f + dy, cr * 1.3f,
+                down ? new int[] { 0xFFDADDE0, 0xFFA9AEB3, 0xFF7C8186 } : new int[] { 0xFFFFFFFF, 0xFFD7DADD, 0xFF9DA2A7 },
+                new float[] { 0f, 0.55f, 1f }, Shader.TileMode.CLAMP));
+        canvas.drawCircle(cx, cy + dy, cr, paint);
+        paint.setShader(null);
+
+        if (!down) { // specular highlight
+            tmp.set(cx - cr * 0.55f, cy - cr * 0.7f, cx + cr * 0.15f, cy - cr * 0.25f);
+            paint.setColor(0x99FFFFFF);
+            canvas.drawOval(tmp, paint);
+        }
+    }
+}
