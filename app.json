{
  "expo": {
    "name": "أوّاب",
    "slug": "owwab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0805"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#d4af37"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohamewael66sorganization.owwab"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0805",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_FULL_SCREEN_INTENT",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "SYSTEM_ALERT_WINDOW",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "package": "com.mohamewael66sorganization.owwab"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#d4af37",
          "sounds": [
            "./assets/audio/azan.mp3",
            "./assets/audio/sali_ala_nabii.mp3",
            "./assets/audio/takbir.mp3"
          ],
          "mode": "production",
          "android": {
            "useNextNotificationsApi": true
          }
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "يحتاج أوّاب للوصول إلى الصور لحفظ صورة القلب وصور الآيات.",
          "savePhotosPermission": "يحتاج أوّاب لحفظ صورة القلب وصور الآيات في معرض الصور.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "./plugins/withFloatingBubble.js",
      "./plugins/withOwwabNative.js"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "2f847531-2e0f-4a14-867d-bdcaa7e74dca"
      }
    }
  }
}
