<?xml version="1.0" encoding="utf-8"?>
<!-- Same as the app's home sky: the arc with the prayers (a bitmap from WidgetSky), and under
     it "باقي على …", the countdown ticking in seconds, and the prayer's time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/mosque_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="باقي على الفجر"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />

        <!-- ticks every second on the launcher, no app process needed -->
        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="46sp"
            android:textStyle="bold"
            android:shadowColor="#99000000"
            android:shadowRadius="10" />

        <TextView
            android:id="@+id/widget_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="٠٤:٣٠"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
